{
  "manifest_version": 3,
  "name": "ContextFlow Translate",
  "short_name": "ContextFlow",
  "description": "Context-aware bilingual webpage translation with your own AI provider and glossary.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "optional_permissions": ["webNavigation"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "ContextFlow Translate",
    "default_popup": "popup.html"
  },
  "commands": {
    "quick-translate": {
      "suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"},
      "description": "Quickly translate the current page"
    },
    "toggle-display": {
      "suggested_key": {"default": "Alt+Shift+Y", "mac": "Alt+Shift+Y"},
      "description": "Switch between original and bilingual views"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
